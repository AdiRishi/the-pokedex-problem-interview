{
  "setupTasks": [
    {
      "name": "Installing Dependencies",
      "command": "pnpm install"
    }
  ],

  "tasks": {
    "build": {
      "name": "build",
      "command": "pnpm build"
    },
    "dev": {
      "name": "dev",
      "command": "pnpm dev",
      "runAtStart": true,
      "preview": {
        "port": 5173
      }
    },
    "start": {
      "name": "start",
      "command": "pnpm start"
    },
    "typecheck": {
      "name": "typecheck",
      "command": "pnpm typecheck"
    },
    "format": {
      "name": "format",
      "command": "pnpm format"
    }
  }
}
